# ─── StudioChair omgevingsvariabelen ───────────────────────────────
# Alles is optioneel: zonder sleutels draait StudioChair volledig op mock-data
# (data/salon-mock.ts) en een in-memory agenda.

# Publieke URL van de site (voor Mollie redirect/webhook)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# DatoCMS — Content Delivery API read-only token
DATOCMS_API_TOKEN=

# Google Calendar — service account met toegang tot de kapper-agenda's
# (deel elke agenda met het e-mailadres van het service account, rechten: "Wijzigingen aanbrengen")
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Mollie — aanbetaling / no-show borg (test_... of live_...)
MOLLIE_API_KEY=

# Resend — bevestigingsmails
RESEND_API_KEY=
RESEND_FROM="StudioChair <boekingen@jouwdomein.nl>"
